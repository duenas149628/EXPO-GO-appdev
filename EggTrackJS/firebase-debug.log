[debug] [2026-10-04T11:28:05.764Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/eggtrack-a01ac/rulesets {"name":"projects/eggtrack-a01ac/rulesets/44ff9cb3-5d22-410c-a3de-ab94e3127732","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function hasProfile() {\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n    function profile() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n    function ownerRole(role) { return role in ['owner', 'Owner', 'OWNER']; }\n    function staffRole(role) { return role in ['staff', 'Staff', 'STAFF']; }\n    function memberOf(businessId) {\n      return hasProfile()\n        && profile().get('businessId', '') == businessId\n        && (ownerRole(profile().role) || staffRole(profile().role))\n        && profile().get('disabled', false) != true\n        && get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'active';\n    }\n    function ownerOf(businessId) {\n      return memberOf(businessId) && ownerRole(profile().role);\n    }\n    function legacyOwner() {\n      return hasProfile()\n        && ownerRole(profile().role)\n        && profile().get('businessId', '') == ''\n        && profile().get('createdFromSignup', false) != true;\n    }\n    function migrationOwner() {\n      return hasProfile()\n        && ownerRole(profile().role)\n        && profile().businessId == request.auth.uid\n        && get(/databases/$(database)/documents/system/businessSetup).data.businessId == request.auth.uid\n        && get(/databases/$(database)/documents/system/businessSetup).data.ownerUid == request.auth.uid\n        && get(/databases/$(database)/documents/system/businessSetup).data.migrationStatus == 'pending';\n    }\n    function validEggCounts(data) {\n      return data.pullet is int && data.pullet >= 0\n        && data.small is int && data.small >= 0\n        && data.medium is int && data.medium >= 0\n        && data.large is int && data.large >= 0\n        && data.xlarge is int && data.xlarge >= 0\n        && data.jumbo is int && data.jumbo >= 0;\n    }\n    function noPendingMigration() {\n      return !exists(/databases/$(database)/documents/system/businessSetup)\n        || get(/databases/$(database)/documents/system/businessSetup).data.migrationStatus != 'pending';\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn() && (\n        request.auth.uid == userId\n        || (ownerOf(resource.data.get('businessId', '')) && staffRole(resource.data.role))\n      );\n      allow create: if signedIn() && (\n        (request.auth.uid == userId\n          && ownerRole(request.resource.data.role)\n          && request.resource.data.businessId == userId\n          && request.resource.data.createdFromSignup == true\n          && noPendingMigration()\n          && getAfter(/databases/$(database)/documents/businesses/$(userId)).data.ownerUid == userId\n          && getAfter(/databases/$(database)/documents/businesses/$(userId)).data.status == 'active')\n        || (ownerOf(request.resource.data.businessId)\n          && staffRole(request.resource.data.role)\n          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'businessId', 'disabled', 'createdAt'])\n          && request.resource.data.disabled != true)\n      );\n      allow update: if signedIn() && (\n        (request.auth.uid == userId && legacyOwner()\n          && ownerRole(request.resource.data.role)\n          && request.resource.data.businessId == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessId']))\n        || (ownerOf(resource.data.businessId)\n          && staffRole(resource.data.role)\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled'])\n          && request.resource.data.disabled == true)\n      );\n      allow delete: if false;\n    }\n\n    match /businesses/{businessId} {\n      allow read: if memberOf(businessId) || (migrationOwner() && businessId == request.auth.uid);\n      allow create: if signedIn() && businessId == request.auth.uid\n        && request.resource.data.ownerUid == request.auth.uid\n        && ((request.resource.data.status == 'active'\n          && noPendingMigration()\n          && ownerRole(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)\n          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId)\n          || (legacyOwner()\n            && request.resource.data.status == 'migrating'\n            && getAfter(/databases/$(database)/documents/system/businessSetup).data.ownerUid == request.auth.uid\n            && getAfter(/databases/$(database)/documents/system/businessSetup).data.migrationStatus == 'pending'));\n      allow update: if migrationOwner() && businessId == request.auth.uid\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])\n        && request.resource.data.status == 'active';\n      allow delete: if false;\n\n      match /inventory/{inventoryId} {\n        allow read: if memberOf(businessId) || (migrationOwner() && businessId == request.auth.uid);\n        allow create, update: if (memberOf(businessId) || (migrationOwner() && businessId == request.auth.uid))\n          && inventoryId == 'main'\n          && validEggCounts(request.resource.data)\n          && request.resource.data.keys().hasOnly(['pullet', 'small', 'medium', 'large', 'xlarge', 'jumbo', 'updatedAt', 'updatedBy', 'updatedByEmail']);\n        allow delete: if false;\n      }\n      match /settings/{settingsId} {\n        allow read: if memberOf(businessId) || (migrationOwner() && businessId == request.auth.uid);\n        allow create, update: if (ownerOf(businessId) || (migrationOwner() && businessId == request.auth.uid)) && settingsId == 'main';\n        allow delete: if ownerOf(businessId) && settingsId == 'main';\n      }\n    }\n\n    match /system/businessSetup {\n      allow read: if migrationOwner();\n      allow create: if legacyOwner()\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.businessId == request.auth.uid\n        && request.resource.data.migrationStatus == 'pending'\n        && !exists(/databases/$(database)/documents/system/businessSetup)\n        && getAfter(/databases/$(database)/documents/businesses/$(request.auth.uid)).data.status == 'migrating';\n      allow update: if migrationOwner()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migrationStatus'])\n        && request.resource.data.migrationStatus == 'complete';\n      allow delete: if false;\n    }\n\n    match /productions/{recordId} {\n      allow read: if memberOf(resource.data.get('businessId', ''))\n        || (legacyOwner() && resource.data.get('businessId', '') in ['', request.auth.uid])\n        || (migrationOwner() && resource.data.get('businessId', '') in ['', request.auth.uid]);\n      allow create: if memberOf(request.resource.data.businessId)\n        && validEggCounts(request.resource.data)\n        && request.resource.data.totalEggs is int\n        && request.resource.data.date is string;\n      allow update: if (ownerOf(resource.data.get('businessId', ''))\n          && request.resource.data.businessId == resource.data.get('businessId', ''))\n        || ((legacyOwner() || migrationOwner())\n          && resource.data.get('businessId', '') in ['', request.auth.uid]\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessId'])\n          && request.resource.data.businessId == request.auth.uid);\n      allow delete: if ownerOf(resource.data.get('businessId', ''));\n    }\n    match /sales/{recordId} {\n      allow read: if memberOf(resource.data.get('businessId', ''))\n        || (legacyOwner() && resource.data.get('businessId', '') in ['', request.auth.uid])\n        || (migrationOwner() && resource.data.get('businessId', '') in ['', request.auth.uid]);\n      allow create: if memberOf(request.resource.data.businessId)\n        && validEggCounts(request.resource.data)\n        && request.resource.data.totalEggs is int\n        && request.resource.data.totalAmount is number\n        && request.resource.data.totalAmount >= 0\n        && request.resource.data.date is string;\n      allow update: if (ownerOf(resource.data.get('businessId', ''))\n          && request.resource.data.businessId == resource.data.get('businessId', ''))\n        || ((legacyOwner() || migrationOwner())\n          && resource.data.get('businessId', '') in ['', request.auth.uid]\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessId'])\n          && request.resource.data.businessId == request.auth.uid);\n      allow delete: if ownerOf(resource.data.get('businessId', ''));\n    }\n\n    match /inventory/{inventoryId} {\n      allow read: if legacyOwner() || migrationOwner();\n      allow write: if false;\n    }\n    match /settings/{settingsId} {\n      allow read: if legacyOwner() || migrationOwner();\n      allow write: if false;\n    }\n    match /{document=**} { allow read, write: if false; }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-04T11:28:06.718687Z","metadata":{"services":["cloud.firestore"]}}
